{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smart-bed/audio.json",
  "title": "ผลโมเดลเสียงบน Node 2",
  "type": "object",
  "required": [
    "v",
    "node",
    "seq",
    "type",
    "t",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "node": {
      "type": "string",
      "pattern": "^node[0-9]+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "const": "audio"
    },
    "t": {
      "type": "integer",
      "minimum": 0,
      "description": "millis() ของ Node"
    },
    "data": {
      "type": "object",
      "required": [
        "label",
        "conf"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "choke",
            "cough",
            "speech",
            "background"
          ]
        },
        "conf": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
